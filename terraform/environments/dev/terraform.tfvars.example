# Terraform 변수 예시 파일
# 이 파일을 terraform.tfvars로 복사하여 실제 값을 입력하세요

# AWS 설정
aws_region = "ap-northeast-2"  # 서울 리전

# 프로젝트 설정
project_name = "my-project"  # 프로젝트 이름
environment = "dev"           # 환경 (dev, staging, prod)

# 네트워크 설정
vpc_cidr = "10.0.0.0/16"

# EC2 설정
key_pair_name = "your-key-pair-name"  # EC2 SSH 키 페어 이름

# EC2 인스턴스 타입 (필요시 변경, 기본값 사용 가능)
main_service_instance_type = "t3.medium"    # MySQL + Redis + API 통합 서버
ai_service_instance_type = "t3.small"       # AI 추천 서비스
nginx_gateway_instance_type = "t3.micro"    # Nginx 게이트웨이

# SSH 접근 허용 IP (개발자 IP 화이트리스트)
admin_ssh_cidrs = [
  "YOUR_IP_ADDRESS/32",    # 개발자 IP
]

# SES 설정
ses_domain = "yourdomain.com"  # 도메인 (예: "mechuragi.kro.kr")
ses_from_email = "noreply@yourdomain.com"

# Bedrock 설정 (기본값 사용 가능)
bedrock_chat_model = "anthropic.claude-3-haiku-20240307-v1:0"
bedrock_smart_model = "anthropic.claude-3-haiku-20240307-v1:0"
bedrock_embedding_model = "amazon.titan-embed-text-v1"

# CloudFront 설정
domain_name = "yourdomain.com"
use_custom_domain = true
wait_for_acm_validation = false  # DNS 설정 후 true로 변경