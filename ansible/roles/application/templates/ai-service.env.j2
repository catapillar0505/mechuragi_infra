# AI Service Environment Variables
SPRING_PROFILES_ACTIVE={{ spring_profiles_active }}
SERVER_PORT={{ ai_service_port }}

# Database Configuration
DB_HOST={{ hostvars['mysql-server']['private_ip'] if hostvars['mysql-server'] is defined else '10.0.1.214' }}
DB_PORT=3306
DB_NAME={{ mysql_database }}
DB_USERNAME={{ mysql_app_user }}
DB_PASSWORD={{ mysql_app_password }}

# Redis Configuration
REDIS_HOST={{ hostvars['redis-server']['private_ip'] if hostvars['redis-server'] is defined else '10.0.1.185' }}
REDIS_PORT={{ redis_port }}

# AWS Configuration
AWS_REGION={{ aws_region }}
BEDROCK_CHAT_MODEL={{ bedrock_chat_model }}
BEDROCK_SMART_MODEL={{ bedrock_smart_model }}
BEDROCK_EMBEDDING_MODEL={{ bedrock_embedding_model }}

# Main Service Configuration
MAIN_SERVICE_URL=http://{{ hostvars['main-service-server']['ansible_host'] if hostvars['main-service-server'] is defined else '15.165.136.100' }}:{{ main_service_port }}

# Logging Configuration
LOGGING_LEVEL_ROOT={{ log_level }}
LOGGING_LEVEL_COM_MECHURAGI=DEBUG
LOGGING_FILE=/var/log/ai-service/application.log