version: '3.8'

services:
  # Main Service - Blue 버전
  main-service-blue:
    image: mamel1016/mechuragi-app:latest
    container_name: {{ project_name }}-main-blue
    ports:
      - "{{ main_service_port }}:8080"
    environment:
      - SPRING_PROFILES_ACTIVE=production
      - SPRING_DATASOURCE_URL=jdbc:mysql://{{ hostvars['mysql-server']['private_ip'] }}:3306/{{ mysql_database }}
      - SPRING_DATASOURCE_USERNAME={{ mysql_app_user }}
      - SPRING_DATASOURCE_PASSWORD={{ mysql_app_password }}
      - SPRING_REDIS_HOST={{ hostvars['redis-server']['private_ip'] }}
      - SPRING_REDIS_PORT={{ redis_port }}
      - REDIS_HOST={{ hostvars['redis-server']['private_ip'] }}
      - REDIS_PORT={{ redis_port }}
      - JWT_SECRET={{ jwt_secret | default('your-jwt-secret-key') }}
      - AWS_REGION={{ aws_region }}
      - S3_BUCKET={{ s3_bucket_name }}
      - SES_FROM_EMAIL={{ ses_email }}
      - BEDROCK_AI_HOST=http://{{ hostvars['ai-service-server']['private_ip'] }}:{{ ai_service_port }}
    restart: unless-stopped
    networks:
      - {{ project_name }}-network
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # Main Service - Green 버전 (배포 시에만 사용)
  main-service-green:
    image: mamel1016/mechuragi-app:latest
    container_name: {{ project_name }}-main-green
    ports:
      - "{{ main_service_port | int + 1 }}:8080"
    environment:
      - SPRING_PROFILES_ACTIVE=production
      - SPRING_DATASOURCE_URL=jdbc:mysql://{{ hostvars['mysql-server']['private_ip'] }}:3306/{{ mysql_database }}
      - SPRING_DATASOURCE_USERNAME={{ mysql_app_user }}
      - SPRING_DATASOURCE_PASSWORD={{ mysql_app_password }}
      - SPRING_REDIS_HOST={{ hostvars['redis-server']['private_ip'] }}
      - SPRING_REDIS_PORT={{ redis_port }}
      - REDIS_HOST={{ hostvars['redis-server']['private_ip'] }}
      - REDIS_PORT={{ redis_port }}
      - JWT_SECRET={{ jwt_secret | default('your-jwt-secret-key') }}
      - AWS_REGION={{ aws_region }}
      - S3_BUCKET={{ s3_bucket_name }}
      - SES_FROM_EMAIL={{ ses_email }}
      - BEDROCK_AI_HOST=http://{{ hostvars['ai-service-server']['private_ip'] }}:{{ ai_service_port }}
    restart: unless-stopped
    networks:
      - {{ project_name }}-network
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    profiles: ["deploy"]  # 배포 시에만 실행

  # Nginx는 호스트에서 직접 실행 (Ansible로 관리)

networks:
  {{ project_name }}-network:
    driver: bridge