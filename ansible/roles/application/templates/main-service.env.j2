# Main Service Environment Variables
SPRING_PROFILES_ACTIVE={{ spring_profiles_active }}
SERVER_PORT={{ main_service_port }}

# Database Configuration
DB_HOST={{ mysql_private_ip }}
DB_PORT=3306
DB_NAME={{ mysql_database }}
DB_USERNAME={{ mysql_app_user }}
DB_PASSWORD={{ mysql_app_password }}

# Redis Configuration
REDIS_HOST={{ redis_private_ip }}
REDIS_PORT={{ redis_port }}

# AWS Configuration
AWS_REGION={{ aws_region }}
S3_BUCKET_NAME={{ s3_bucket_name }}
SES_FROM_EMAIL={{ ses_email }}

# AI Service Configuration
AI_SERVICE_URL=http://{{ ai_service_private_ip }}:{{ ai_service_port }}

# Logging Configuration
LOGGING_LEVEL_ROOT={{ log_level }}
LOGGING_LEVEL_COM_MECHURAGI=DEBUG