version: '3.8'

services:
  ai-service:
    image: openjdk:17-jdk-slim
    container_name: mechuragi-ai-service
    ports:
      - "{{ ai_service_port }}:{{ ai_service_port }}"
    environment:
      - SPRING_PROFILES_ACTIVE=production
      - SERVER_PORT={{ ai_service_port }}
      - DB_HOST={{ mysql_private_ip }}
      - DB_PORT=3306
      - DB_NAME={{ mysql_database }}
      - DB_USERNAME={{ mysql_app_user }}
      - DB_PASSWORD={{ mysql_app_password }}
      - REDIS_HOST={{ redis_private_ip }}
      - REDIS_PORT={{ redis_port }}
      - AWS_REGION={{ aws_region }}
      - BEDROCK_CHAT_MODEL={{ bedrock_chat_model }}
      - BEDROCK_SMART_MODEL={{ bedrock_smart_model }}
      - BEDROCK_EMBEDDING_MODEL={{ bedrock_embedding_model }}
      - MAIN_SERVICE_URL=http://{{ main_service_public_ip }}:{{ main_service_port }}
    volumes:
      - {{ app_directory }}/ai-service.jar:/app/ai-service.jar:ro
      - {{ config_directory }}:/config:ro
      - /var/log/ai-service:/var/log/ai-service
    working_dir: /app
    command: ["java", "-jar", "ai-service.jar"]
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ ai_service_port }}/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 90s
    networks:
      - mechuragi-ai-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  mechuragi-ai-network:
    driver: bridge