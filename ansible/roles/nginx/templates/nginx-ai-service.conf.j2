upstream ai_backend {
    # AI 서비스 Docker 컨테이너
    server 127.0.0.1:{{ ai_service_port }} max_fails=3 fail_timeout=30s;
}

server {
    listen 80;
    server_name _;

    # 클라이언트 업로드 크기 제한
    client_max_body_size 10M;

    # 헬스체크 엔드포인트 (Nginx 자체)
    location /nginx-health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # API 요청을 AI Service로 프록시
    location /api/ {
        proxy_pass http://ai_backend/;

        # 헤더 설정
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS headers if needed
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        # 타임아웃 설정 (AI 모델 처리 시간 고려)
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # 버퍼링 설정
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Actuator 헬스체크 (직접 접근 허용)
    location /actuator/health {
        proxy_pass http://ai_backend/actuator/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 헬스체크는 빠른 응답 필요
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }

    # Actuator 엔드포인트들
    location /actuator/ {
        proxy_pass http://ai_backend/actuator/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # IP 기반 접근 제어 (보안)
        allow 10.0.0.0/16;  # VPC 내부만 허용
        allow 127.0.0.1;     # 로컬호스트 허용
        deny all;
    }

    # 기본 경로 - AI Service는 CloudFront를 통해 /api/*로만 접근되므로 404 응답
    # Nginx는 오직 /api/* 경로만 처리
    location / {
        access_log off;
        return 404 "This server only handles /api/* requests. Frontend is served via CloudFront.\n";
        add_header Content-Type text/plain;
    }

    # 에러 페이지
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }

    error_log /var/log/nginx/ai_service_error.log;
    access_log /var/log/nginx/ai_service_access.log;
}
