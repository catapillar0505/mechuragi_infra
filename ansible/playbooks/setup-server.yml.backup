---
- name: 메추라기 서버 설정
  hosts: mechuragi-server
  become: yes
  gather_facts: yes

  tasks:
    - name: 1. 시스템 패키지 업데이트
      command: yum update -y

    - name: 2. 필수 패키지 설치 (git, curl, wget, vim, htop)
      command: yum install -y git curl wget vim htop

    - name: 3. Docker 설치
      command: yum install -y docker

    - name: 4. Docker 서비스 시작 및 활성화
      systemd:
        name: docker
        state: started
        enabled: yes

    - name: 5. ec2-user를 docker 그룹에 추가
      user:
        name: ec2-user
        groups: docker
        append: yes

    - name: 6. Docker Compose 설치
      get_url:
        url: "https://github.com/docker/compose/releases/download/v2.21.0/docker-compose-linux-x86_64"
        dest: /usr/local/bin/docker-compose
        mode: '0755'

    - name: 7. Docker Compose 심볼릭 링크 생성
      file:
        src: /usr/local/bin/docker-compose
        dest: /usr/bin/docker-compose
        state: link

    - name: 8. MySQL 8.0 Docker 컨테이너 실행
      command: docker run -d --name mysql-server --restart unless-stopped -e MYSQL_ROOT_PASSWORD={{ mysql_root_password }} -p 3306:3306 mysql:8.0
      ignore_errors: yes

    - name: 9. MySQL 컨테이너 준비 대기 (30초)
      pause:
        seconds: 30

    - name: 10. MySQL 연결 테스트
      command: docker exec mysql-server mysql -u root -p{{ mysql_root_password }} -e 'SELECT VERSION();'
      register: mysql_test
      ignore_errors: yes

    - name: 11. MySQL 연결 테스트 결과 출력
      debug:
        msg: "MySQL connection test: {{ mysql_test.stdout if mysql_test.rc == 0 else 'Connection failed' }}"

    - name: 12. Redis 설치 (amazon-linux-extras 사용)
      command: amazon-linux-extras install -y redis6

    - name: 13. Redis 설정 - bind 주소 변경
      lineinfile:
        path: /etc/redis.conf
        regexp: '^bind 127.0.0.1'
        line: 'bind 0.0.0.0'
        backup: yes

    - name: 14. Redis 포트 설정
      lineinfile:
        path: /etc/redis.conf
        regexp: '^port'
        line: "port {{ redis_port }}"

    - name: 15. Redis 서비스 시작 및 활성화
      systemd:
        name: redis
        state: started
        enabled: yes

    - name: 16. Redis 연결 테스트 (ping)
      command: redis-cli ping
      register: redis_ping
      ignore_errors: yes

    - name: 17. Redis 연결 테스트 결과 출력
      debug:
        msg: "Redis 연결 상태: {{ redis_ping.stdout if redis_ping.rc == 0 else 'Redis 연결 실패' }}"

    - name: 18. Redis 메모리 사용량 확인
      command: redis-cli info memory
      register: redis_memory
      ignore_errors: yes

    - name: 19. Redis 메모리 정보 출력
      debug:
        msg: "Redis 메모리 정보: {{ redis_memory.stdout_lines[:5] if redis_memory.rc == 0 else 'Redis 메모리 정보 확인 실패' }}"

    - name: 20. 애플리케이션 디렉토리 생성
      file:
        path: /home/ec2-user/app
        state: directory
        owner: ec2-user
        group: ec2-user
        mode: '0755'

    - name: 21. 포트 3306 리스닝 상태 확인
      command: netstat -tuln | grep 3306
      register: port_check
      ignore_errors: yes

    - name: 22. 포트 3306 리스닝 결과 출력
      debug:
        msg: "포트 3306 상태: {{ port_check.stdout if port_check.rc == 0 else '포트가 열려있지 않음' }}"

    - name: 23. MySQL 버전 정보 확인
      command: docker exec mysql-server mysql --version
      register: mysql_version
      ignore_errors: yes

    - name: 24. MySQL 버전 정보 출력
      debug:
        msg: "MySQL 버전: {{ mysql_version.stdout if mysql_version.rc == 0 else '버전 확인 실패' }}"

    - name: 25. Docker 및 Redis 서비스 상태 확인
      command: systemctl is-active docker redis
      register: service_status
      ignore_errors: yes

    - name: 26. 서비스 상태 결과 출력
      debug:
        msg: "서비스 상태: {{ service_status.stdout_lines if service_status.rc == 0 else '서비스 상태 확인 실패' }}"

    - name: 27. 실행 중인 Docker 컨테이너 목록 확인
      command: docker ps
      register: docker_containers
      ignore_errors: yes

    - name: 28. Docker 컨테이너 목록 출력
      debug:
        msg: "실행 중인 컨테이너: {{ docker_containers.stdout_lines if docker_containers.rc == 0 else '컨테이너 목록 확인 실패' }}"

    - name: 29. 설치 완료 메시지 출력
      debug:
        msg:
          - "🎉 메추라기 서버 설정 완료!"
          - "Docker, MySQL, Redis가 설치되고 실행 중입니다."
          - "모든 상태 확인이 완료되었습니다."
