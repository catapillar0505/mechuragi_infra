# Redis Configuration for t3.small (2 GB RAM)

# Network
bind 0.0.0.0
port {{ redis_port }}
protected-mode no

# General
daemonize yes
supervised systemd
pidfile /var/run/redis/redis-server.pid
loglevel notice
logfile /var/log/redis/redis-server.log

# Working directory
dir /var/lib/redis

# Memory management for t3.small
maxmemory 1gb
maxmemory-policy allkeys-lru

# Persistence
save 900 1
save 300 10
save 60 10000

stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb

# AOF (Append Only File)
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# Slow log
slowlog-log-slower-than 10000
slowlog-max-len 128

# Clients
timeout 300
tcp-keepalive 300
tcp-backlog 511

# Security (no authentication for internal network)
# requirepass your_password_here

# Limits
maxclients 100