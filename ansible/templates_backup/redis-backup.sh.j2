#!/bin/bash

# Redis Backup Script for Mechuragi
BACKUP_DIR="/var/backups/redis"
DATE=$(date +%Y%m%d_%H%M%S)
REDIS_DATA_DIR="/var/lib/redis"
BACKUP_FILE="${BACKUP_DIR}/redis_${DATE}.tar.gz"

# Create backup
cd ${REDIS_DATA_DIR}
tar -czf ${BACKUP_FILE} dump.rdb appendonly.aof 2>/dev/null

# Check if backup was successful
if [ $? -eq 0 ]; then
    echo "$(date): Redis backup successful: ${BACKUP_FILE}" >> /var/log/redis-backup.log

    # Remove backups older than 7 days
    find ${BACKUP_DIR} -name "redis_*.tar.gz" -mtime +7 -delete
else
    echo "$(date): Redis backup failed!" >> /var/log/redis-backup.log
    exit 1
fi