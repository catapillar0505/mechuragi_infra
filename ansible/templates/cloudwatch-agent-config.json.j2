{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/openresty/access.log",
            "log_group_name": "/aws/{{ project_name }}/{{ env }}/nginx-gateway",
            "log_stream_name": "{instance_id}/access.log",
            "retention_in_days": 30,
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/openresty/error.log",
            "log_group_name": "/aws/{{ project_name }}/{{ env }}/nginx-gateway",
            "log_stream_name": "{instance_id}/error.log",
            "retention_in_days": 30,
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
