# OpenResty Nginx Configuration for Mechuragi API Gateway
# JWT 검증 + Blue-Green 배포 지원

user www-data;
worker_processes auto;
pid /usr/local/openresty/nginx/logs/nginx.pid;

# JWT Secret (Ansible 변수로 주입)
env JWT_SECRET;

events {
    worker_connections 1024;
}

http {
    include /usr/local/openresty/nginx/conf/mime.types;
    default_type application/octet-stream;

    # JWT Secret 공유 메모리 (환경변수 캐싱)
    lua_shared_dict env_secrets 128k;

    # 서버 시작 시 환경변수 로드
    init_by_lua_block {
        local secret = os.getenv("JWT_SECRET")
        if secret then
            ngx.shared.env_secrets:set("jwt_secret", secret)
        else
            ngx.log(ngx.ERR, "JWT_SECRET is missing in Environment!")
        end
    }

    # 로깅 설정
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/openresty/access.log main;
    error_log /var/log/openresty/error.log debug;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Gzip 압축
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss
               application/rss+xml font/truetype font/opentype
               application/vnd.ms-fontobject image/svg+xml;

    # Blue-Green 배포: 메인 서버 Upstream
    upstream main_server {
        # 기본값: Blue (8080)
        # Ansible에서 배포 시 동적으로 변경
        server {{ main_service_private_ip }}:{{ main_server_active_port }};
    }

    # AI 서버 Upstream
    upstream ai_server {
        server {{ ai_service_private_ip }}:8082;
    }

    # 메인 서버 (API Gateway)
    server {
        listen 80;
        server_name _;

        # 클라이언트 요청 크기 제한 (파일 업로드 고려)
        client_max_body_size 50M;

        # ==========================================
        # /api/* 경로: 메인 서버로 프록시 (Spring Security 검증)
        # ==========================================
        location /api/ {
            proxy_pass http://main_server;
            proxy_http_version 1.1;  # SSE는 HTTP/1.1 이상 필수

            # [필수] SSE 스트리밍 지연 방지
            proxy_buffering off;             # Nginx 버퍼에 데이터가 쌓이지 않도록 즉시 전송
            proxy_cache off;                 # 실시간성 보장을 위해 캐싱 비활성화
            chunked_transfer_encoding on;    # 대용량/스트리밍 응답을 위한 청크 전송 활성화

            # [필수] SSE 연결 유지 (웹소켓 Upgrade 설정 제거)
            proxy_set_header Connection '';

            # 프록시 헤더 설정
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # [타임아웃] t3.small 환경 및 SSE 유지 고려
            # 60초마다 heartbeat를 보낸다면 300초 정도가 적당합니다.
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 300s;
        }

        # ==========================================
        # /actuator/* 경로: 헬스체크 및 모니터링
        # ==========================================
        location /actuator/ {
            proxy_pass http://main_server;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ==========================================
        # 카카오 로그인 요청 - 인증서버로 리다이렉트
        # ==========================================
        location /oauth2/authorization/ {
            proxy_pass http://main_server;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            # 나는 80번(HTTP)으로 요청을 받지만,
            proxy_set_header X-Forwarded-Proto https; # Spring아, 이거 원래 프로토콜은 https야!
            proxy_set_header X-Forwarded-Port 443;   # Spring아, 이거 원래 포트는 443이었어!

            proxy_redirect off;
        }

        # ==========================================
        # 카카오 로그인 리다이렉트 경로
        # ==========================================
        location /login/oauth2/ {
            proxy_pass http://main_server;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port 443;

            proxy_redirect off;
        }

        # ==========================================
        # OAuth2 콜백 - 프론트엔드 SPA 처리 (백엔드로 프록시 X)
        # Nginx 직접 접근 시 CloudFront로 리다이렉트하여 SPA 정상 흐름 유도
        # ==========================================
        location = /oauth2/callback {
            return 301 https://{{ domain_name }}$request_uri;
        }

        # ==========================================
        # /recommend 경로: AI 서버로 프록시 (Nginx에서 JWT 검증)
        # ==========================================
        location /recommend/food {
            # Lua를 이용한 JWT 검증
            access_by_lua_block {
                local jwt = require "resty.jwt"
                local cjson = require "cjson"

                -- [DEBUG 1] Lua 블록 진입 확인
                ngx.log(ngx.WARN, "=== DEBUG: LUA BLOCK START - /recommend/food ===")
                ngx.log(ngx.WARN, "=== DEBUG: Request URI: ", ngx.var.uri)
                ngx.log(ngx.WARN, "=== DEBUG: Request Method: ", ngx.var.request_method)

                -- Authorization 헤더에서 JWT 토큰 추출
                local auth_header = ngx.var.http_authorization

                -- [DEBUG 2] Authorization 헤더 확인
                if auth_header then
                    ngx.log(ngx.WARN, "=== DEBUG: Auth header present, length: ", string.len(auth_header))
                else
                    ngx.log(ngx.ERR, "=== DEBUG: AUTH HEADER MISSING ===")
                    ngx.status = 401
                    ngx.say(cjson.encode({error = "Missing Authorization header"}))
                    return ngx.exit(401)
                end

                -- Bearer 토큰 파싱
                local token = auth_header:match("Bearer%s+(.+)")

                -- [DEBUG 3] Bearer 토큰 파싱 결과
                if not token then
                    ngx.log(ngx.ERR, "=== DEBUG: BEARER TOKEN PARSE FAILED ===")
                    ngx.status = 401
                    ngx.say(cjson.encode({error = "Invalid Authorization format. Expected: Bearer <token>"}))
                    return ngx.exit(401)
                else
                    ngx.log(ngx.WARN, "=== DEBUG: Token parsed, length: ", string.len(token))
                end

                -- JWT Secret 가져오기 (공유 메모리에서)
                local jwt_secret = ngx.shared.env_secrets:get("jwt_secret")

                -- [DEBUG 4] JWT Secret 확인
                if not jwt_secret then
                    ngx.log(ngx.ERR, "=== DEBUG: JWT_SECRET NOT FOUND IN SHARED MEMORY ===")
                    ngx.status = 500
                    ngx.say(cjson.encode({error = "Internal server error"}))
                    return ngx.exit(500)
                else
                    ngx.log(ngx.WARN, "=== DEBUG: JWT_SECRET found, length: ", string.len(jwt_secret))
                end

                -- JWT 검증
                ngx.log(ngx.WARN, "=== DEBUG: Starting JWT verification ===")
                local jwt_obj = jwt:verify(jwt_secret, token)

                -- [DEBUG 5] JWT 검증 결과
                ngx.log(ngx.WARN, "=== DEBUG: JWT verified: ", tostring(jwt_obj.verified))
                if jwt_obj.reason then
                    ngx.log(ngx.WARN, "=== DEBUG: JWT reason: ", jwt_obj.reason)
                end

                if not jwt_obj.verified then
                    ngx.log(ngx.WARN, "=== DEBUG: JWT VERIFICATION FAILED ===")
                    ngx.status = 401
                    ngx.say(cjson.encode({error = "Invalid or expired token"}))
                    return ngx.exit(401)
                end

                ngx.log(ngx.WARN, "=== DEBUG: JWT VALID - Proceeding to AI server ===")
            }

            # SSE 스트리밍을 위한 설정 추가
            proxy_buffering off;             # 응답 버퍼링 비활성화 (실시간 전송 필수)
            proxy_cache off;                 # 캐싱 비활성화
            chunked_transfer_encoding on;    # 청크 단위 전송 활성화

            # SSE 연결 유지를 위한 헤더
            proxy_set_header Connection '';
            proxy_http_version 1.1;          # SSE는 HTTP 1.1 이상 권장

            # AI 서버로 프록시
            proxy_pass http://ai_server;

            # 프록시 헤더 설정
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Authorization 헤더를 AI 서버로 그대로 전달
            proxy_set_header Authorization $http_authorization;

            #타임아웃 설정 (AI 생성 시간이 길 수 있으므로 넉넉하게 유지)
            proxy_connect_timeout 60s;
            proxy_send_timeout 120s;
            proxy_read_timeout 300s;         # SSE 연결이 끊기지 않도록 충분히 설정
        }

        # ==========================================
        # 루트 경로: 메인 서버로 프록시
        # ==========================================
        location / {
           proxy_pass http://main_server;
            proxy_http_version 1.1;

            # 프록시 헤더 설정
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # [수정] 웹소켓 지원 제거 (기존 Upgrade, Connection "upgrade" 삭제)
            # SSE 및 일반 HTTP 유지를 위해 Connection 헤더 초기화
            proxy_set_header Connection "";

            # [추가] 스트리밍 지원 (루트 경로를 통한 SSE 호출 대비)
            proxy_buffering off;
            proxy_cache off;

            # [타임아웃] 메인 서버의 SSE와 일반 요청을 고려한 설정
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 300s; # SSE 연결 유지를 위해 5분으로 상향
        }

        # ==========================================
        # Nginx 자체 헬스체크 엔드포인트
        # ==========================================
        location /nginx-health {
            access_log off;
            return 200 "Nginx Gateway OK\n";
            add_header Content-Type text/plain;
        }
    }
}